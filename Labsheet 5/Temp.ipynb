
import pandas as pd
import matplotlib.pyplot as plt
from pathlib import Path

# STUDENT ACADEMIC PERFORMANCE ANALYSIS
# Using Pandas and Matplotlib

# 1. Create Student Dataset
data = {
    "Student_ID": range(101, 113),
    "Student_Name": [
        "Amit", "Neha", "Rahul", "Priya", "Rohan", "Kavya",
        "Arjun", "Simran", "Vikas", "Anjali", "Ravi", "Pooja"
    ],
    "Gender": [
        "Male", "Female", "Male", "Female", "Male", "Female",
        "Male", "Female", "Male", "Female", "Male", "Female"
    ],
    "Department": [
        "BCA", "BCA", "MCA", "BCA", "MCA", "MCA",
        "BCA", "MCA", "BCA", "MCA", "BCA", "MCA"
    ],
    "Attendance": [90, 85, 65, 95, 75, 88, 55, 92, 80, 70, 60, 98],
    "Study_Hours": [5, 6, 2, 7, 4, 8, 2, 6, 5, 3, 2, 9],
    "Assignment_Marks": [85, 90, 60, 95, 75, 92, 50, 88, 78, 65, 55, 98],
    "Internal_Assessment_Marks": [80, 92, 55, 90, 70, 95, 45, 85, 75, 60, 50, 96],
    "Python_Marks": [88, 95, 60, 92, 75, 96, 45, 90, 78, 65, 52, 98],
    "DBMS_Marks": [85, 90, 58, 88, 72, 94, 48, 86, 76, 62, 55, 97],
    "AI_Marks": [90, 94, 62, 95, 78, 98, 50, 92, 80, 68, 58, 99],
    "Final_Exam_Marks": [87, 93, 59, 91, 74, 95, 46, 89, 77, 64, 53, 97]
}

df = pd.DataFrame(data)

# Load external CSV if available
if Path("students.csv").exists():
    df = pd.read_csv("students.csv")

# 2. Data Cleaning
df.drop_duplicates(inplace=True)
df.dropna(subset=["Student_ID", "Student_Name"], inplace=True)
df["Student_Name"] = df["Student_Name"].astype(str).str.strip()

numeric_cols = [
    "Attendance", "Study_Hours", "Assignment_Marks",
    "Internal_Assessment_Marks", "Python_Marks",
    "DBMS_Marks", "AI_Marks", "Final_Exam_Marks"
]

for col in numeric_cols:
    df[col] = pd.to_numeric(df[col], errors="coerce")
    df[col] = df[col].fillna(df[col].mean())

# 3. Data Transformation
performance_cols = [
    "Assignment_Marks",
    "Internal_Assessment_Marks",
    "Python_Marks",
    "DBMS_Marks",
    "AI_Marks",
    "Final_Exam_Marks"
]

df["Average_Marks"] = df[performance_cols].mean(axis=1)

df["Performance"] = df["Average_Marks"].apply(
    lambda x: "High Performing" if x >= 75
    else ("Low Performing" if x < 40 else "Average Performing")
)

print("\nSTUDENT DATASET")
print(df.to_string(index=False))

# 4. High Performing Students
print("\nHIGH PERFORMING STUDENTS")
print(df[df["Performance"] == "High Performing"][
    ["Student_Name", "Average_Marks"]
])

# 5. Low Performing Students
print("\nLOW PERFORMING STUDENTS")
print(df[df["Performance"] == "Low Performing"][
    ["Student_Name", "Average_Marks"]
])

# 6. Subject-wise Performance
subjects = [
    "Python_Marks", "DBMS_Marks",
    "AI_Marks", "Final_Exam_Marks"
]

print("\nSUBJECT-WISE AVERAGE PERFORMANCE")
print(df[subjects].mean())

# 7. Attendance Pattern
print("\nATTENDANCE ANALYSIS")
print("Average Attendance:", df["Attendance"].mean())
print("Highest Attendance:", df["Attendance"].max())
print("Lowest Attendance:", df["Attendance"].min())

# 8. Relationship Between Study Hours and Marks
print("\nSTUDY HOURS AND MARKS CORRELATION")
print(df["Study_Hours"].corr(df["Average_Marks"]))

# 9. Relationship Between Attendance and Performance
print("\nATTENDANCE AND PERFORMANCE CORRELATION")
print(df["Attendance"].corr(df["Average_Marks"]))

# 10. Department-wise Performance
print("\nDEPARTMENT-WISE AVERAGE MARKS")
print(df.groupby("Department")["Average_Marks"].mean())

# 11. Attendance Categories
df["Attendance_Category"] = pd.cut(
    df["Attendance"],
    bins=[0, 60, 75, 85, 100],
    labels=["Low", "Moderate", "Good", "Excellent"],
    include_lowest=True
)

print("\nATTENDANCE PATTERNS")
print(df["Attendance_Category"].value_counts())

# 12. Data Visualization
plt.figure(figsize=(15, 10))

# Chart 1: Top 5 Students
plt.subplot(2, 3, 1)
top_students = df.nlargest(5, "Average_Marks")
plt.bar(top_students["Student_Name"], top_students["Average_Marks"])
plt.title("Top 5 Performing Students")
plt.xlabel("Students")
plt.ylabel("Average Marks")
plt.xticks(rotation=30)

# Chart 2: Subject-wise Performance
plt.subplot(2, 3, 2)
subject_avg = df[subjects].mean()
plt.bar(subject_avg.index, subject_avg.values)
plt.title("Subject-wise Average Marks")
plt.ylabel("Average Marks")
plt.xticks(rotation=30)

# Chart 3: Attendance Pattern
plt.subplot(2, 3, 3)
attendance_counts = df["Attendance_Category"].value_counts()
plt.pie(
    attendance_counts,
    labels=attendance_counts.index,
    autopct="%1.1f%%"
)
plt.title("Attendance Distribution")

# Chart 4: Study Hours vs Marks
plt.subplot(2, 3, 4)
plt.scatter(df["Study_Hours"], df["Average_Marks"])
plt.title("Study Hours vs Performance")
plt.xlabel("Study Hours")
plt.ylabel("Average Marks")

# Chart 5: Attendance vs Performance
plt.subplot(2, 3, 5)
plt.scatter(df["Attendance"], df["Average_Marks"])
plt.title("Attendance vs Performance")
plt.xlabel("Attendance (%)")
plt.ylabel("Average Marks")

# Chart 6: Department-wise Performance
plt.subplot(2, 3, 6)
dept_avg = df.groupby("Department")["Average_Marks"].mean()
plt.bar(dept_avg.index, dept_avg.values)
plt.title("Department-wise Performance")
plt.xlabel("Department")
plt.ylabel("Average Marks")

plt.tight_layout()

# Save visualization
plt.savefig("Student_Performance_Analysis.png")
plt.show()

# 13. Save Final Analysis Dataset
df.to_csv("Student_Analysis_Result.csv", index=False)

print("\nPROJECT COMPLETED SUCCESSFULLY!")
print("Visualization saved as Student_Performance_Analysis.png")
print("Dataset saved as Student_Analysis_Result.csv")
